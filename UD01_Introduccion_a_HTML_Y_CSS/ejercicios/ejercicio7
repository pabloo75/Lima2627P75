<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Horario Lectivo</title>
</head>
<body>

    <table border="1">
        <caption>Horario Semanal de Clases</caption>
        <thead>
            <tr>
                <th>Hora</th>
                <th>Lunes</th>
                <th>Martes</th>
                <th>Miércoles</th>
                <th>Jueves</th>
                <th>Viernes</th>
            </tr>
        </thead>
        <tbody>
            <tr><!-- Sesión 1 -->
                <td>08:30 - 09:25</td>
                <td rowspan="2">Sistemas Informáticos</td>
                <td>Bases de Datos</td>
                <td rowspan="2">Sistemas Informáticos</td>
                <td>Programación</td>
                <td>Bases de Datos</td>
            </tr>
            <tr><!-- Sesión 2 -->
                <td>09:25 - 10:20</td>
                <td>Entornos de Desarrollo</td>
                <td>Programación</td>
                <td>Entornos de Desarrollo</td>
            </tr>
            <tr><!-- Sesión 3 -->
                <td>10:20 - 11:15</td>
                <td>Lenguajes de Marcas</td>
                <td>Bases de Datos</td>
                <td>Programación</td>
                <td>Bases de Datos</td>
                <td>Lenguajes de Marcas</td>
            </tr>
            <tr><!-- Recreo -->
                <td>11:15 - 11:45</td>
                <td colspan="5" align="center"><strong>RECREO</strong></td>
            </tr>
            <tr><!-- Sesión 4 -->
                <td>11:45 - 12:40</td>
                <td rowspan="2">Programación</td>
                <td>Lenguajes de Marcas</td>
                <td rowspan="2">Bases de Datos</td>
                <td rowspan="2">Sistemas Informáticos</td>
                <td rowspan="2">Programación</td>
            </tr>
            <tr><!-- Sesión 5 -->
                <td>12:40 - 13:35</td>
                <td>Sostenibilidad</td>
            </tr>
            <tr><!-- Sesión 6 -->
                <td>13:35 - 14:30</td>
                <td>FOL / Itinerario laboral</td>
                <td>FOL / Itinerario laboral</td>
                <td>Digitalización</td>
                <td>FOL / Itinerario laboral</td>
                <td>Inglés Técnico</td>
            </tr>
        </tbody>
        <tfoot></tfoot>
    </table>

</body>
</html>