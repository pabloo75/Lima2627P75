<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Horario Lectivo</title>
</head>
<body>

    <table border="1">
        <caption>Horario Semanal de Clases</caption>
        <thead>
            <tr>
                <th>Hora</th>
                <th>Lunes</th>
                <th>Martes</th>
                <th>Miércoles</th>
                <th>Jueves</th>
                <th>Viernes</th>
            </tr>
        </thead>
        <tbody>
            <tr><!-- Sesión 1 -->
                <td>08:30 09:20</td>
                <td rowspan="2">Bases de Datos</td>
                <td>ContDes</td>
                <td>Ingles</td>
                <td rowspan="2">Bases de Datos</td>
                <td rowspan="2">LIMA</td>
            </tr>
            <tr><!-- Sesión 2 -->
                <td>09:20 10:10</td>
                <td>LIMA</td>
                <td>Contornos</td>
            </tr>
            <tr><!-- recreo -->
                <td> </td>
                <td colspan="5" align="center"><strong>RECREO</strong></td>
            </tr>
            <tr><!-- Sesión 3 -->
                <td>10:30 11:20</td>
                <td>ItrPerEmpleo</td>
                <td>Ingles</td>
                <td rowspan="2">Sistemas Informáticos</td>
                <td>LIMA</td>
                <td rowspan="2">Programación</td>
            </tr>
            <tr><!-- Sesión 4 -->
                <td>11:20 12:10</td>
                <td>ContDes</td>
                <td>Bases de datos</td>
                <td>Sustentabilidad</td>
            </tr>
            <tr><!-- recreo -->
                <td> </td>
                <td colspan="5" align="center"><strong>RECREO</strong></td>
            </tr>
            <tr><!-- Sesión 5 -->
                <td>12:30 13:20</td>
                <td rowspan="2">Sistemas</td>
                <td rowspan="2">Programación</td>
                <td rowspan="2">Bases de datos</td>
                <td rowspan="2">Programación</td>
                <td rowspan="2">Sistemas informáticos</td>
            </tr>
            <tr><!-- Sesión 6-->
                <td>13:20 14:10</td>
            </tr>
            <tr><!-- Mediodia -->
                <td>14:10
                    14:50</td>
                <td colspan="5" align="center"><strong>Mediodia</strong></td>
            </tr>
            <tr> <!-- Sesión 7 -->
                <td>14:50 15:40</td>
                <td rowspan="3">Programación</td>
                <td rowspan="3"></td>
                <td rowspan="3">ItrPerEmpleo</td>
                <td rowspan="3"></td>
                <td rowspan="3"></td>
            </tr>
            <tr><!-- Sesión 8-->
                <td>15:40 16:30</td>
            </tr>
            <tr><!-- Sesión 9-->
                <td>16:30 17:20</td>
            </tr>
        </tbody>
        <tfoot></tfoot>
    </table>

</body>
</html>